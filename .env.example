# Copy this file to .env.local and fill in your Supabase project's values
# (Project Settings -> API in the Supabase dashboard).
#
# If left unset, the app runs in demo mode: no network calls are made and
# you sign in with the seeded demo accounts shown on the login page.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
